{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "analytics",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "analytics-db",
			"database_id": "ab724698-cd22-49c7-9c1b-b1b815873650"
		}
	],
	"vars": {
		"ADMIN_PASSWORD": "your-password-here"
	}
}